<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.eda-archetype</groupId>
  <artifactId>eda-archetype</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>maven-archetype</packaging>

  <name>eda-archetype</name>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <!--
      Velocity (test scope): renders the archetype-resources templates in the
      unit suites, so the #if guards of the templates are asserted on the REAL
      rendered output instead of on the mere presence of a flag token.
      2.4.1 is the version the archetype plugin resolves at runtime.
    -->
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity-engine-core</artifactId>
      <version>2.4.1</version>
      <scope>test</scope>
    </dependency>
    <!--
      groovy-json (test scope): parses the JSON contract schema and the JSON
      examples of the PACKAGED PROCEDURE (llm-maven-flags-inference/04-referencia-templates-de-contrato/).
      Same version as the Groovy the build already uses.
    -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy-json</artifactId>
      <version>4.0.28</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.4.1</version>
      </extension>
    </extensions>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>META-INF/maven/archetype-metadata.xml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <!--
            The archetype integration run copies WHOLE generated projects into
            target/test-classes/projects (each one carrying its own target/).
            Those nested classes are not ours: without this exclude surefire
            scans them and dies with "wrong name: it/pkg/..." before any suite
            runs. Kept here (and not as a "mvn clean" ritual) so a dirty target
            can never mask the real test result.
          -->
          <excludes>
            <exclude>projects/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>xml-maven-plugin</artifactId>
        <version>1.2.1</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <goals>
              <goal>transform</goal>
            </goals>
            <configuration>
              <!--
                forceCreation=true: the archetype catalog is assembled from the
                property-*.xml fragments via external XML entities, but the
                plugin's staleness check only looks at the aggregator file
                (archetype-metadata.xml). Without forceCreation, editing a
                property-*.xml fragment silently leaves a STALE catalog in
                target/classes - the flag set actually used by the archetype
                would not match the source of truth.
              -->
              <forceCreation>true</forceCreation>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <transformationSets>
            <transformationSet>
              <dir>src/main/resources/META-INF/maven</dir>
              <includes>
                <include>archetype-metadata.xml</include>
              </includes>
              <stylesheet>src/main/resources/META-INF/maven/archetype-metadata-identity.xsl</stylesheet>
              <outputDir>${project.build.outputDirectory}/META-INF/maven</outputDir>
            </transformationSet>
          </transformationSets>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.gmaven</groupId>
        <artifactId>groovy-maven-plugin</artifactId>
        <version>2.1.1</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.28</version>
          </dependency>
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-xml</artifactId>
            <version>4.0.28</version>
            <scope>runtime</scope>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>archetype-post-generate-composer-execute</id>
            <phase>process-resources</phase>
            <goals>
              <goal>execute</goal>
            </goals>
            <configuration>
              <source>${project.basedir}/src/main/groovy/ArchetypePostGenerateComposer.groovy</source>
            </configuration>
          </execution>
          <!--
            Unit-test runner (added 2026-10-23, bug
            contrato-json-inferido-inoperante): the Groovy unit
            suites are plain scripts (no JUnit infra), so surefire never picked
            them up and `mvn test` ran ZERO tests. This execution runs the
            runner in the `test` phase and fails the build when any suite fails.

            classpathScope=test: the default is `none`, so the project's test
            dependencies were NOT visible to the suites. The template suites
            need Velocity (test scope) to render the archetype-resources
            templates.
          -->
          <execution>
            <id>archetype-post-generate-test-runner</id>
            <phase>test</phase>
            <goals>
              <goal>execute</goal>
            </goals>
            <configuration>
              <source>${project.basedir}/src/test/groovy/run-archetype-post-generate-tests.groovy</source>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
