<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>com.eda-archetype</groupId>
  <artifactId>eda-archetype</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>maven-archetype</packaging>

  <name>eda-archetype</name>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <extension>
        <groupId>org.apache.maven.archetype</groupId>
        <artifactId>archetype-packaging</artifactId>
        <version>3.4.1</version>
      </extension>
    </extensions>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <excludes>
          <exclude>META-INF/maven/archetype-metadata.xml</exclude>
        <exclude>META-INF/archetype-post-generate.groovy</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>xml-maven-plugin</artifactId>
        <version>1.2.1</version>
        <executions>
          <execution>
            <phase>generate-resources</phase>
            <goals>
              <goal>transform</goal>
            </goals>
            <configuration>
              <!--
                forceCreation=true: the archetype catalog is assembled from the
                property-*.xml fragments via external XML entities, but the
                plugin's staleness check only looks at the aggregator file
                (archetype-metadata.xml). Without forceCreation, editing a
                property-*.xml fragment silently leaves a STALE catalog in
                target/classes - the flag set actually used by the mechanism
                and by the archetype would not match the source of truth.
              -->
              <forceCreation>true</forceCreation>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <transformationSets>
            <transformationSet>
              <dir>src/main/resources/META-INF/maven</dir>
              <includes>
                <include>archetype-metadata.xml</include>
              </includes>
              <stylesheet>src/main/resources/META-INF/maven/identity.xsl</stylesheet>
              <outputDir>${project.build.outputDirectory}/META-INF/maven</outputDir>
            </transformationSet>
          </transformationSets>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.gmaven</groupId>
        <artifactId>groovy-maven-plugin</artifactId>
        <version>2.1.1</version>
        <dependencies>
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>4.0.28</version>
          </dependency>
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-json</artifactId>
            <version>4.0.28</version>
            <scope>runtime</scope>
          </dependency>
          <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-xml</artifactId>
            <version>4.0.28</version>
            <scope>runtime</scope>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>snippet-composer-execute</id>
            <phase>process-resources</phase>
            <goals>
              <goal>execute</goal>
            </goals>
            <configuration>
              <source>${project.basedir}/src/main/groovy/eda/postgenerate/SnippetComposer.groovy</source>
            </configuration>
          </execution>
          <!--
            The Orchestrator (src/main/groovy/eda/postgenerate/llmflag/Orchestrator.groovy)
            is a CLI tool, not a build step. Per cli-contract.md, the operator invokes it
            directly (e.g., `groovy Orchestrator.groovy ...args...`) to obtain the
            mvn archetype:generate command line. It is NOT wired into the archetype's
            own build lifecycle, because the archetype build has no description/contract.
          -->
          <!--
            Unit-test runner (added 2026-10-23, bug
            contrato-json-inferido-inoperante): the Groovy unit suites are plain
            scripts (no JUnit infra), so surefire never picked them up and
            `mvn test` ran ZERO tests - a green build did not mean the 110 unit
            checks had passed. This execution runs every suite in the `test`
            phase and fails the build when any suite fails.
          -->
          <execution>
            <id>unit-test-runner-execute</id>
            <phase>test</phase>
            <goals>
              <goal>execute</goal>
            </goals>
            <configuration>
              <source>${project.basedir}/src/test/groovy/run-all-tests.groovy</source>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-archetype-plugin</artifactId>
          <version>3.4.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
