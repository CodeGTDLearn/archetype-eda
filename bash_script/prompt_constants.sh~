enable_folder_src_test_java=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_FOLDER_SRC_TEST_JAVA_PROMPT")
enable_folder_src_test_resources=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_FOLDER_SRC_TEST_RESOURCES_PROMPT")
enable_lombok=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_LOMBOK_PROMPT")
enable_yml_file_in_main_resources=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_YML_FILE_IN_MAIN_RESOURCES_PROMPT")
enable_security_authentic_support=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_SECURITY_AUTHENTICATION_SUPPORT_PROMPT")

# D.2.2) Compound Inputs
enable_custom_attributes=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_CUSTOM_ATTRIBUTES_PROMPT")
custom_attributes_list_input
enable_dependencies_addition=$(user_input_or_return_for_default_value "boleana" "false" "$ENABLE_DEPENDENCIES_ADD_PROMPT")
