#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = ${git_url_repo}
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "${git_branch_repo}"]
	remote = origin
	merge = refs/heads/${git_branch_repo}