<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- STANDARD FILE LOG __________________________________________________-->
    <property name="ROL_FILE_PATTERN_MESSAGE" value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="ROL_FILE_ROOT" value="./logs"/>
    <property name="ROL_FILE_LOCATION" value="std_logs_rol"/>
    <property name="ROL_FILE_NAME" value="spring-std_logs_rol"/>
    <appender name="STANDARD_FILE_ROLLING" class="RollingFileAppender">
        <file>${ROL_FILE_ROOT}/${ROL_FILE_LOCATION}/${ROL_FILE_NAME}.log</file>

        <encoder class="PatternLayoutEncoder">
            <pattern>${ROL_FILE_PATTERN_MESSAGE}</pattern>
        </encoder>

        <rollingPolicy class="TimeBasedRollingPolicy">
            <fileNamePattern>
                ${ROL_FILE_ROOT}/${ROL_FILE_LOCATION}/${ROL_FILE_NAME}_%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- JSON-FILE LOG ROLLING ______________________________________________-->
    <property name="JSON_FILE_ROL_ROOT" value="./logs"/>
    <property name="JSON_FILE_ROL_LOCATION" value="json_logs_rol"/>
    <property name="JSON_FILE_ROL_NAME" value="spring-json_logs_rol"/>
    <appender name="JSON_FILE_ROLLING" class="RollingFileAppender">

        <file>${JSON_FILE_ROL_ROOT}/${JSON_FILE_ROL_LOCATION}/${JSON_FILE_ROL_NAME}.json</file>

        <rollingPolicy class="TimeBasedRollingPolicy">
            <fileNamePattern>${JSON_FILE_ROL_ROOT}/${JSON_FILE_ROL_LOCATION}/${JSON_FILE_ROL_NAME}_%d{yyyy-MM-dd}.json
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
        </rollingPolicy>

        <encoder class="JsonEncoder"/>
    </appender>

    <!-- JSON-FILE LOG ______________________________________________________-->
    <property name="JSON_FILE_ROOT" value="./logs"/>
    <property name="JSON_FILE_STD_LOCATION" value="json_logs_std"/>
    <property name="JSON_FILE_STD_NAME" value="spring-json_logs_std"/>
    <appender name="JSON_FILE_STANDARD" class="FileAppender">

        <file>${JSON_FILE_ROOT}/${JSON_FILE_STD_LOCATION}/${JSON_FILE_STD_NAME}.json</file>

        <encoder class="JsonEncoder">
            <pattern>
                {
                  "date": "%date{ISO8601,GMT+2}",
                  "priority": "%level",
                  "pid": "${PID}",
                  "thread": "%t",
                  "logger": "%logger",
                  "message": "%.-10000msg",
                  "stacktrace": "%.-10000throwable",
                  "team": "%property{team}"
                }
            </pattern>
        </encoder>
    </appender>

</configuration>