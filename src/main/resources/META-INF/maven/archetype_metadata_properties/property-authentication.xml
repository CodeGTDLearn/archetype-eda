<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-AUTHENTICATION.XML _______________________________ -->
<!-- FLAG: enable_jwt_authentication -->
<!--   DESCRIPTION : Habilita autenticacao JWT no projeto -->
<!--                 (par de chaves appJwt.key/appJwt.pub). -->
<!--   PROMPT      : Enable 'JWT Authentication' -->
<!--   TYPE        : boolean -->
<!--   DEFAULT     : false -->
<!--   DOMAIN      : true | false -->
<!--   DEPENDS_ON  : nao aplicavel -->
<!--   VALIDATION  : ^(true|false)$ -->
<requiredProperty key="enable_jwt_authentication">
    <defaultValue>false</defaultValue>
    <validationRegex>^(true|false)$</validationRegex>
</requiredProperty>
