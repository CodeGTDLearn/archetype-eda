<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-ENTITY.XML ________________________________________ -->
<!-- FLAG: entity_name -->
<!--   DESCRIPTION : Nome da entidade principal do projeto (PascalCase, ex.: MyEntity). -->
<!--   PROMPT      : Digite o nome do 'Entity' -->
<!--   TYPE        : entity_name -->
<!--   DEFAULT     : MyEntity -->
<!--   DOMAIN      : ^[A-Z][a-zA-Z0-9_]+$ -->
<!--   DEPENDS_ON  : nao aplicavel -->
<!--   VALIDATION  : ^[A-Z][a-zA-Z0-9_]+$ -->
<requiredProperty key="entity_name">
    <defaultValue>MyEntity</defaultValue>
    <validationRegex>^[A-Z][a-zA-Z0-9_]+$</validationRegex>
</requiredProperty>

<!-- FLAG: entity_name_package -->
<!--   DESCRIPTION : Pacote Java derivado (lowercase) de entity_name. -->
<!--                 NAO TROCAR a derivacao - Groovy/templates dependem. -->
<!--   PROMPT      : (auto-derivado de entity_name) -->
<!--   TYPE        : package -->
<!--   DEFAULT     : (derivado de entity_name) -->
<!--   DOMAIN      : ^[a-z][a-z0-9_.]+$ -->
<!--   DEPENDS_ON  : E derivado automaticamente de entity_name (em -->
<!--                  minusculas, sem caracteres especiais). NAO e uma -->
<!--                  pergunta feita ao usuario. O Groovy de pos- -->
<!--                  processamento aplica a transformacao ${entity_ -->
<!--                  name,,} para gerar o pacote Java. Se o usuario -->
<!--                  alterar entity_name, este valor e recalculado. -->
<!--   VALIDATION  : ^[a-z][a-z0-9_.]+$ -->
<requiredProperty key="entity_name_package">
    <defaultValue/>
    <validationRegex>^[a-z][a-z0-9_.]+$</validationRegex>
</requiredProperty>

<!-- FLAG: enable_custom_attributes -->
<!--   DESCRIPTION : Habilita a inclusao de atributos customizados na entidade principal. -->
<!--   PROMPT      : Add 'Custom Attributes' -->
<!--   TYPE        : boolean -->
<!--   DEFAULT     : false -->
<!--   DOMAIN      : true | false -->
<!--   DEPENDS_ON  : nao aplicavel -->
<!--   VALIDATION  : ^(true|false)$ -->
<requiredProperty key="enable_custom_attributes">
    <defaultValue>false</defaultValue>
    <validationRegex>^(true|false)$</validationRegex>
</requiredProperty>

<!-- FLAG: custom_attributes_list -->
<!--   DESCRIPTION : Lista de atributos no formato 'Tipo:nome', separados por virgula -->
<!--                 (ex.: Long:id, MyId:id, My_Id:my_id). -->
<!--                 Observacao: pode assumir a string 'false' quando enable_custom_attributes=false -->
<!--                 (NAO TROCAR - Groovy depende). -->
<!--   PROMPT      : Provide the 'Attributes' -->
<!--   TYPE        : list (entity_list_attributes) -->
<!--   DEFAULT     : Long:id, MyId:id, My_Id:my_id -->
<!--   DOMAIN      : false OR lista de Tipo:nome (virgula) -->
<!--   DEPENDS_ON  : enable_custom_attributes = true -->
<!--   VALIDATION  : ^(false|[A-Z][a-zA-Z0-9_]*:[a-z][a-zA-Z0-9_]*(,[A-Z][a-zA-Z0-9_]*:[a-z][a-zA-Z0-9_]*)*)$ -->
<requiredProperty key="custom_attributes_list">
    <defaultValue>Long:id, MyId:id, My_Id:my_id</defaultValue>
    <validationRegex>^(false|[A-Z][a-zA-Z0-9_]*:[a-z][a-zA-Z0-9_]*(,[A-Z][a-zA-Z0-9_]*:[a-z][a-zA-Z0-9_]*)*)$</validationRegex>
</requiredProperty>

<!-- FLAG: enable_json_entity_contracts -->
<!--   DESCRIPTION : Habilita a criacao da entidade a partir de um arquivo JSON de contrato (fluxo JSON). -->
<!--   PROMPT      : Creating 'Entity from JSON' -->
<!--   TYPE        : boolean -->
<!--   DEFAULT     : false -->
<!--   DOMAIN      : true | false -->
<!--   DEPENDS_ON  : nao aplicavel -->
<!--   VALIDATION  : ^(true|false)$ -->
<requiredProperty key="enable_json_entity_contracts">
    <defaultValue>false</defaultValue>
    <validationRegex>^(true|false)$</validationRegex>
</requiredProperty>

<!-- FLAG: absolute_path_jsonfile_contract -->
<!--   DESCRIPTION : Caminho absoluto (Linux) do arquivo JSON que define o contrato da entidade. -->
<!--   PROMPT      : Enter file location -->
<!--   TYPE        : path -->
<!--   DEFAULT     : (vazio - definido no fluxo JSON) -->
<!--   DOMAIN      : /path/file.json -->
<!--   DEPENDS_ON  : enable_json_entity_contracts = true -->
<!--   VALIDATION  : ^\/([^\/]+\/)*[^\/]+\.json$ -->
<requiredProperty key="absolute_path_jsonfile_contract">
    <defaultValue/>
    <validationRegex>^\/([^\/]+\/)*[^\/]+\.json$</validationRegex>
</requiredProperty>
