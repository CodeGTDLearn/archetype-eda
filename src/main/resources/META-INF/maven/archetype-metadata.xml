<?xml version="1.0" encoding="UTF-8"?>
<!--  ARCHETYPE-HEADER.XML  _______________________________________________  -->



<archetype-descriptor
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-catalog/1.1.0
        http://maven.apache.org/xsd/archetype-catalog-1.1.0.xsd"
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-catalog/1.1.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        name="arch">

    <requiredProperties>



<!-- ______________ -->





        <!--   PROPERTY-AUTHENTICATION.XML   ______________________________  -->
        <!-- JWT-AUTHENTICATION -->
        <requiredProperty key="enable_jwt_authentication">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-BINDING-PROPERTIES-TESTS.XML  _______________________ -->

        <requiredProperty key="enable_binding_properties_tests">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-BINDING-PROPERTIES.XML   ____________________________ -->
        <requiredProperty key="enable_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="default_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="list_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="map_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="mutable_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="validated_binding_properties">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-CPANEL.XML __________________________________________ -->
        <requiredProperty key="enable_api_cpanel">
            <defaultValue></defaultValue>
        </requiredProperty>


        <requiredProperty key="enable_api_cpanel_elk_log_system">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-DOCKER.XML  ________________________________________  -->
        <requiredProperty key="enable_docker">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-ENTITY.XML  _________________________________________ -->
        <requiredProperty key="entity_name"/>

        <requiredProperty key="enable_custom_attributes">
            <defaultValue></defaultValue>
        </requiredProperty>

        <requiredProperty key="custom_attributes_list"/>








        <!--  PROPERTY-GENERAL.XML  _______________________________________  -->
        <requiredProperty key="project_description"/>


        <requiredProperty key="show_archetype_pos_processor_log">
            <defaultValue></defaultValue>
        </requiredProperty>









        <!-- PROPERTY-JAVA-VERSION.XML _____________________________________ -->
        <requiredProperty key="java_version">
            <defaultValue></defaultValue>
        </requiredProperty>










        <!--  PROPERTY-LOGBACK.XML _________________________________________ -->
        <requiredProperty key="enable_logback">
            <defaultValue></defaultValue>
        </requiredProperty>


        <requiredProperty key="logback_console_type">
            <defaultValue></defaultValue>
        </requiredProperty>


        <requiredProperty key="enable_logback_appender_smtp">
            <defaultValue></defaultValue>
        </requiredProperty>


        <requiredProperty key="enable_logback_appender_file">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-LOMBOK.XML  ________________________________________  -->
        <requiredProperty key="enable_lombok">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-POM-DEPENDENCIES.XML  ______________________________  -->
        <requiredProperty key="extra_POM_dependencies">
            <defaultValue></defaultValue>
        </requiredProperty>








        <!--  PROPERTY-PROPERTIES-FILETYPE.XML   ___________________________ -->
        <requiredProperty key="properties_filetype">
            <defaultValue></defaultValue>
        </requiredProperty>










        <!--   PROPERTY-TEST.XML ___________________________________________ -->
        <requiredProperty key="enable_folder_src_test_java">
            <defaultValue></defaultValue>
        </requiredProperty>








    <!--  ARCHETYPE-TRANSITION.XML  _______________________________________  -->
    </requiredProperties>
    <fileSets>










        <!--  FILESET-BINDING-PROPERTIES-TEST.XML __________________________ -->

        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/test/resources/properties_test</directory>
            <includes>
                <include>**/*.yml</include>
                <include>**/*.properties</include>
            </includes>
        </fileSet>








        <!--  FILESET-BINDING-PROPERTIES.XML _______________________________ -->


        <!-- SRC\MAIN\RESOURCES\PROPERTIES -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources/properties</directory>
            <includes>
                <include>**/*.properties</include>
                <include>**/*.yml</include>
            </includes>
        </fileSet>


        <!-- SRC\MAIN\RESOURCES\PROTECTED_PROPERTIES -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources/protected_properties</directory>
            <includes>
                <include>**/*.properties</include>
                <include>**/*.yml</include>
            </includes>
        </fileSet>








        <!--  FILESET-CPANEL.XML ___________________________________________ -->
        <!-- CPANEL / ELK SUPPORT -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>ELK</directory>
            <includes>
                <include>**/*.*</include>
            </includes>
        </fileSet>








        <!--  FILESET-DOCKER.XML  __________________________________________ -->
        <!-- DOCKER SUPPORT -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>docker</directory>
            <includes>
                <include>**/*compose*.yml</include>
                <include>**/*compose*.yaml</include>
                <include>**/*Dockerfile*</include>
            </includes>
        </fileSet>








        <!--  FILESET-GENERAL.XML  _________________________________________ -->
        <!-- MAVEN -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>.mvn/wrapper</directory>
            <includes>
                <include>**/*.properties</include>
            </includes>
        </fileSet>

        <!-- GENERAL FILES -->
        <fileSet encoding="UTF-8">
            <directory></directory>
            <includes>
                <include>.gitignore</include>
                <include>HELP.md</include>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
            </includes>
        </fileSet>








        <!--   FILESET-LOGBACK.XML   _______________________________________ -->
        <!-- LOGBACK SUPPORT -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources/logback-spring-config</directory>
            <includes>
                <include>**/*.xml</include>
            </includes>
        </fileSet>








        <!--  FILESET-SRC.XML  _____________________________________________ -->
        <!-- SRC\MAIN -->
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
            <directory>src/main/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>

        <!-- SRC\MAIN\RESOURCES -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/main/resources</directory>
            <includes>

                <include>data.sql</include>
                <include>schema.sql</include>

                <include>app.key</include>
                <include>app.pub</include>

                <include>application.yml</include>
                <include>application.properties</include>

                <include>logback-spring.xml</include>

                <include>banner.txt</include>

            </includes>
        </fileSet>








        <!--  FILESET-SRC-TEST.XML   _______________________________________ -->
        <!-- SRC\TEST -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/test/java</directory>
            <includes>
                <include>**/*.java</include>
            </includes>
        </fileSet>



        <!-- SRC\TEST\RESOURCES -->
        <fileSet filtered="true" encoding="UTF-8">
            <directory>src/test/resources</directory>
            <includes>

                <include>application.yml</include>
                <include>application.properties</include>

                <include>logback-test.xml</include>

                <include>banner.txt</include>

            </includes>
        </fileSet>


<!-- ______________ -->






    <!--    ARCHETYPE-FOOTER.XML  _________________________________________  -->
    </fileSets>
</archetype-descriptor>


<!-- ______________ -->