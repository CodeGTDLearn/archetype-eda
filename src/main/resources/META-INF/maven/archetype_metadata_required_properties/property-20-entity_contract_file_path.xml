<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-20-ENTITY_CONTRACT_FILE_PATH.XML _________________ -->
<!-- FLAG: entity_contract_file_path -->
<!--   DESCRIPTION : Caminho do arquivo JSON que contem o contrato do modulo. -->
<!--                 Preenchido pelo agente, via procedimento para especificação (que grava o -->
<!--                 contrato extraido do prompt e emite o caminho aqui). Quando o -->
<!--                 arquivo existe E enable_folder_src_test_java=true, o -->
<!--                 pos-processador copia o contrato para -->
<!--                 src/test/resources/contracts/contract.json no projeto -->
<!--                 gerado - o contrato passa a ser a base do modulo. -->
<!--   PROMPT      : (interno - preenchido pelo agente, via procedimento para especificação) -->
<!--   TYPE        : path -->
<!--   DEFAULT     : none -->
<!--   DOMAIN      : none OU caminho absoluto para arquivo .json (o procedimento exige caminho absoluto) -->
<!--   DEPENDS_ON  : enable_folder_src_test_java = true (a pasta de contratos -->
<!--                  existe apenas quando a arvore de testes e mantida) -->
<!--   VALIDATION  : ^(none|[^\r\n]*\.json)$ (permissiva: aceita caminho relativo; o procedimento recusa com STOP-DER-04) -->
<requiredProperty key="entity_contract_file_path">
    <defaultValue>none</defaultValue>
    <validationRegex>^(none|[^\r\n]*\.json)$</validationRegex>
</requiredProperty>
