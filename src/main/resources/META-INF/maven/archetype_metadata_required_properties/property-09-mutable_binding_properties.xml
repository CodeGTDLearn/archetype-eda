<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-09-MUTABLE_BINDING_PROPERTIES.XML ________________ -->
<!-- FLAG: mutable_binding_properties -->
<!--   DESCRIPTION : Define se e quantas propriedades customizadas podem ser mutaveis. -->
<!--                 Observacao: pode ser o literal "false" (quando desabilitado) -->
<!--                 ou um numero 1..3 (quantidade de propriedades mutaveis). -->
<!--                 NAO TROCAR - Groovy/templates dependem. -->
<!--   PROMPT      : Enter 'Mutable Binding Properties' -->
<!--   TYPE        : mixed (string|number) -->
<!--   DEFAULT     : false -->
<!--   DOMAIN      : false | 1..3 -->
<!--   DEPENDS_ON  : So faz sentido perguntar se a flag de sistema -->
<!--                  enable_binding_properties estiver ligada como true -->
<!--                  E pelo menos um dos tres sub-modulos (default, list, -->
<!--                  map) tambem estiver ligado como true. Caso contrario, -->
<!--                  o proprio sistema ja fixa o valor como false. -->
<!--   VALIDATION  : ^(false|([1-3]))$ -->
<requiredProperty key="mutable_binding_properties">
    <defaultValue>false</defaultValue>
    <validationRegex>^(false|([1-3]))$</validationRegex>
</requiredProperty>
