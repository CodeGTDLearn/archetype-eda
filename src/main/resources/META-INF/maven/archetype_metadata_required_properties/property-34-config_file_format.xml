<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-34-CONFIG_FILE_FORMAT.XML ________________________ -->
<!-- FLAG: config_file_format -->
<!--   DESCRIPTION : Formato do arquivo de config: 1=yml (deleta os .yml e -->
<!--                  mantem os .properties), 2=properties (deleta os .properties -->
<!--                  e mantem os .yml). Apenas um formato sobrevive. -->
<!--   PROMPT      : Enter 'Config File Format' (1=yml, 2=properties) -->
<!--   TYPE        : enum (number) -->
<!--   DEFAULT     : 1 -->
<!--   DOMAIN      : 1 | 2 -->
<!--   DEPENDS_ON  : nao aplicavel -->
<!--   VALIDATION  : ^[1-2]$ -->
<requiredProperty key="config_file_format">
    <defaultValue>1</defaultValue>
    <validationRegex>^[1-2]$</validationRegex>
</requiredProperty>
