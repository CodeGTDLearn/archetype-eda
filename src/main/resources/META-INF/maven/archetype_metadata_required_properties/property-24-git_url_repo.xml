<?xml version="1.0" encoding="UTF-8"?>
<!-- PROPERTY-24-GIT_URL_REPO.XML ______________________________ -->
<!-- FLAG: git_url_repo -->
<!--   DESCRIPTION : URL do repositorio Git remoto (formato https ou git). -->
<!--   PROMPT      : Enter 'Git URL Repository' -->
<!--   TYPE        : url (git_url) -->
<!--   DEFAULT     : https://github.com/your-git-user/your-repo.git -->
<!--   DOMAIN      : ^(https?://|git@).+\.git$ -->
<!--   DEPENDS_ON  : enable_git_support = true -->
<!--   VALIDATION  : ^(https?://|git@).+\.git$ -->
<requiredProperty key="git_url_repo">
    <defaultValue>https://github.com/your-git-user/your-repo.git</defaultValue>
    <validationRegex>^(https?://|git@).+\.git$</validationRegex>
</requiredProperty>
