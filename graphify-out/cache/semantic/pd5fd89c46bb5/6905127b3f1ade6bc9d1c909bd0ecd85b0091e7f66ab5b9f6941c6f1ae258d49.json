{"nodes": [{"id": "specs_002_native_groovy_composer_research_phase_0_research", "label": "Phase 0 Research: Native Groovy Composer", "file_type": "document", "source_file": "specs/002-native-groovy-composer/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_native_groovy_composer_research_process_resources_phase", "label": "process-resources Maven phase decision", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase chosen because it follows generate-resources (where xml-maven-plugin:transform runs) and precedes package/integration-test; mirrors precedent set by xml-maven-plugin and avoids mixing two transformers in the same phase."}, {"id": "specs_002_native_groovy_composer_research_groovy_4_0_28_decision", "label": "Groovy 4.0.28 classpath decision", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Declare org.apache.groovy:groovy:4.0.28 + groovy-json:4.0.28 as plugin <dependencies> to add to gmaven 2.1.1 classpath; no initial exclusion of gmaven-adapter-impl because conflict risk is low. Empirically the override did not apply (gmaven 2.1.1 bundles Groovy 2.4.9) but composer ran successfully with the bundled version."}], "edges": [{"source": "specs_002_native_groovy_composer_contracts_composer_contract_groovy_maven_plugin", "target": "specs_002_native_groovy_composer_research_process_resources_phase", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-native-groovy-composer/research.md", "source_location": "lines 9-18 (Decision 1)", "weight": 1.0}, {"source": "specs_002_native_groovy_composer_research_phase_0_resear