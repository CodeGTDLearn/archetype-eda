{"nodes": [{"id": "specs_003_llm_flag_inference_research_phase_0_research", "label": "Phase 0 Research: LLM Flag Inference", "file_type": "document", "source_file": "specs/003-llm-flag-inference/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_003_llm_flag_inference_research_xinclude_extraction", "label": "XInclude flag catalog extraction", "file_type": "rationale", "source_file": "specs/003-llm-flag-inference/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read target/classes/META-INF/maven/archetype-metadata.xml (already XInclude-merged by xml-maven-plugin:1.2.1 + identity.xsl); parse with groovy-xml. Reject hardcoded flag list (FR-013) to avoid drift between bash prompt scripts and catalog."}, {"id": "specs_003_llm_flag_inference_research_json_canonicalization", "label": "Sorted-key JSON canonicalization (no JCS library)", "file_type": "rationale", "source_file": "specs/003-llm-flag-inference/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use groovy-json to recursively sort object keys before serialization; SHA-256 via JDK MessageDigest. Rejected RFC 8785 (JCS) library to avoid new dependency; rejected raw JsonOutput (unstable cache keys) and hashCode() (non-portable)."}, {"id": "specs_003_llm_flag_inference_research_external_inference_decision", "label": "External LLM inference delegation", "file_type": "rationale", "source_file": "specs/003-llm-flag-inference/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shell out to operator-supplied $EDA_LLM_INFERENCE_BIN to keep Groovy code free of HTTP-client/SDK dependencies; lets operator reuse existing LLM tooling. FR-012 byte-equivalence enforced via temperature=0 contract on the script."}], "edges": [{"source": "specs_003_llm_flag_inference_data_model_cache_key_entry", "target": "specs_003_llm_flag_inference_research_json_canonicalization", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inference/research.md", "source_location": "Decision 4 lines 47-59", "weight": 1.0}, {"source": "specs_003_llm_flag_inference_data_model_flag_catalog_entry", "target": "specs_003_llm_flag_inference_research_xinclude_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inference/research.md", "source_location": "Decision 3 lines 35-46", "weight": 1.0}, {"source": "specs_003_llm_flag_inference_data_model_external_inference_script", "target": "specs_003_llm_flag_inference_research_external_inference_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inference/research.md", "source_location": "Decision 6 lines 74-83", "weight": 1.0}, {"source": "specs_003_llm_flag_inference_research_phase_0_research", "target": "specs_003_llm_flag_inference_research_xinclude_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inference/research.md", "source_location": "Decision 3 lines 35-46", "weight": 1.0}, {"source": "specs_003_llm_flag_inference_research_phase_0_research", "target": "specs_003_llm_flag_inference_research_json_canonicalization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inference/research.md", "source_location": "Decision 4 lines 47-59", "weight": 1.0}, {"source": "specs_003_llm_flag_inference_research_phase_0_research", "target": "specs_003_llm_flag_inference_research_external_inference_decision", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/003-llm-flag-inferen