{"nodes": [{"id": ".opencode_commands_speckit_assess_intake_md", "label": "speckit.assess.intake command", "file_type": "document", "source_file": ".opencode/commands/speckit.assess.intake.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_url_trust_policy", "label": "URL Trust Policy", "file_type": "rationale", "source_file": ".opencode/commands/speckit.assess.intake.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classifies hosts/schemes as refuse-outright (loopback, RFC1918, metadata endpoints) vs allowlisted public sources vs unrecognized. Defeats DNS rebinding by requiring connection-pinning to validated public addresses."}, {"id": "concept_path_safety_ancestor_check", "label": "Path Safety / Ancestor Symlink Resolution", "file_type": "rationale", "source_file": ".opencode/commands/speckit.assess.intake.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before any read/write, resolves the real (symlink-stripped) path of every ancestor (e.g. .specify, .specify/assessments/<slug>) and refuses if any component is a symlink or escapes the project root. Blocks a cloned or crafted project from redirecting I/O outside the repo."}, {"id": "concept_slug_safety_normalization", "label": "Slug Normalization & Safety", "file_type": "rationale", "source_file": ".opencode/commands/speckit.assess.intake.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalize slugs to lowercase + [a-z0-9-] only (strip '.', '/', '\\'); collapse repeated '-'; reject empty results. Guarantees the constructed ASSESS_DIR cannot escape its parent directory."}], "edges": [{"source": ".opencode_commands_speckit_assess_intake_md", "target": ".opencode_commands_speckit_assess_research_md", "relation": "references",