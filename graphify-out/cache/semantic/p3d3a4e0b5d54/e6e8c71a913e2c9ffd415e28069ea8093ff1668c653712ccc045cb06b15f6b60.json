{"nodes": [{"id": "specs_011_rename_procedure_folders_research_research", "label": "011 Phase 0 Research", "file_type": "document", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d1_rename_item", "label": "D1 \u2014 Rename with Rename-Item, no copy+delete", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rename-Item preserves content, attributes and identity and is easy to audit; pre-checking the destination avoids silent overwrite; git mv is rejected because git must not run outside declared hooks."}, {"id": "specs_011_rename_procedure_folders_research_d2_reference_boundary", "label": "D2 \u2014 Boundary between textual reference and normative content", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the name token is replaced so rules, JSON keys, defaultValue, validationRegex and prose survive; without this boundary a broad substitution could rewrite rules or examples."}, {"id": "specs_011_rename_procedure_folders_research_d3_single_manifest", "label": "D3 \u2014 Single rename manifest as source of truth", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d4_closed_inventory", "label": "D4 \u2014 Closed nominal inventory (92 lines)", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d5_legacy_redirect", "label": "D5 \u2014 Legacy redirect preserved, target updated", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming utils/01-entrada-inicializacao would break earlier specs; creating extra redirects would widen scope without a requirement."}, {"id": "specs_011_rename_procedure_folders_research_d6_readme_per_phase", "label": "D6 \u2014 README updated per phase, never in phase 3", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d7_existing_suites", "label": "D7 \u2014 Update existing suites, create no new suite", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The eight suites read fixed paths and would fail before validating the feature; ProcedureEntryRenameContractTest is already phase-aware, so it is the natural place to adjust expectations."}, {"id": "specs_011_rename_procedure_folders_research_d8_packaged_artifact_gate", "label": "D8 \u2014 target/classes as gate, installed JAR opt-in", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d9_performance_guard", "label": "D9 \u2014 No new performance target, 10% regression guard", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renaming folders and one file should not change build time, so the existing feature 007 budget (max 10% over local mvn -B test baseline) is reused as a guard rather than a new acceptance criterion."}, {"id": "specs_011_rename_procedure_folders_research_d10_no_new_deps", "label": "D10 \u2014 No new dependency, flag or procedure file", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d11_phase_division", "label": "D11 \u2014 Phase division (folder 01, folder 02, file 02)", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_procedure_folders_research_d12_exact_names", "label": "D12 \u2014 Exact final names and filesystem behavior", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hyphen separators, .md extension and numeral-first naming follow the existing convention; spaces from the request and the typo 'archtype' are rejected, and a collision aborts the phase before any overwrite."}, {"id": "specs_011_rename_procedure_folders_research_d13_readme_anchors", "label": "D13 \u2014 README anchors updated (href, id, name)", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updating only the visible heading would leave the README index and internal links pointing at stale anchor ids."}, {"id": "specs_011_rename_procedure_folders_research_d14_historical_specs", "label": "D14 \u2014 Historical specs excluded from the corpus", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewriting specs/ would inflate the diff and risk without affecting the shipped procedure; the clarification confirmed history is not operational corpus."}, {"id": "specs_011_rename_procedure_folders_research_risks", "label": "011 Risk Table (collision, case-insensitivity, duplicated line tokens)", "file_type": "concept", "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_011_rename_procedure_folders_research_research", "target": "specs_011_rename_procedure_folders_contracts_rename_manifest_manifest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_011_rename_procedure_folders_research_research", "target": "specs_011_rename_procedure_folders_spec_feature_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_011_rename_procedure_folders_research_research", "target": "specs_011_rename_procedure_folders_research_d1_rename_item", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/011-rename-procedure-folders/research.md", "source_location": null, "weight": 1.0}, {"source": "specs_011_rename_procedure_folders_research_research", "target": "specs_011_rename_procedure_folders_research_d2_reference_boundary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour