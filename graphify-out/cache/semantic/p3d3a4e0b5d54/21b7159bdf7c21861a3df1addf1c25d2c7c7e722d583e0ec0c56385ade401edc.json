{"nodes": [{"id": "specs_007_hard_stop_contract_contracts_verification", "label": "Contract \u2014 Verification of SC-002, NFR-001, NFR-002", "file_type": "document", "source_file": "specs/007-hard-stop-contract/contracts/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_hard_stop_contract_contracts_verification_sc002review", "label": "SC-002 Beginner Operator Review", "file_type": "rationale", "source_file": "specs/007-hard-stop-contract/contracts/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comprehension is proven with a fixed 6-message sample (STOP-IN-01, STOP-ENV-03, STOP-DER-01, STOP-DER-02, STOP-CONF-01, STOP-CONF-02) reviewed by someone who did not implement the messages, answering 5 questions per message; 6/6 OK is the acceptance bar."}, {"id": "specs_007_hard_stop_contract_contracts_verification_nfr001buildbudget", "label": "NFR-001 Build Time Budget (max 10% increase)", "file_type": "rationale", "source_file": "specs/007-hard-stop-contract/contracts/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build time is measured locally before and after implementation with mvn -B test; the delta must stay at or below 10% of the baseline, else the change must be investigated before closing."}, {"id": "specs_007_hard_stop_contract_contracts_verification_nfr002offlinedeterminism", "label": "NFR-002 Offline Determinism", "file_type": "rationale", "source_file": "specs/007-hard-stop-contract/contracts/verification.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two offline mvn -o -B test runs must produce identical [archetype-post-generate] output lines; any difference is nondeterminism that must be fixed before concluding."}], "edges":