{"nodes": [{"id": "_specify_extensions_git_readme_git_branching_workflow_extension", "label": "Git Branching Workflow Extension (Spec Kit)", "file_type": "concept", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git operations are provided as an optional, self-contained module so spec creation never blocks on Git: spec directories are still created, branch operations are skipped with warnings, and remote detection returns empty results when Git is unavailable."}, {"id": "_specify_extensions_git_readme_git_config_yml", "label": "git-config.yml (git extension configuration)", "file_type": "concept", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_specify_extensions_git_readme_branch_numbering_strategy", "label": "Branch numbering strategy (sequential / timestamp)", "file_type": "rationale", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_specify_extensions_git_readme_branch_template_tokens", "label": "Branch name template tokens ({author}/{app}/{number}/{slug})", "file_type": "rationale", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Custom templates must keep {slug} after {number} and start the final path segment with {number}- so generated names remain valid feature branches; monorepo projects use {author}/{app}/{number}-{slug} (e.g. jdoe/web/008-guided-tour) while preserving per-project feature numbering."}, {"id": "_specify_extensions_git_readme_auto_commit_hooks", "label": "Auto-commit hooks (per-command, configurable)", "file_type": "rationale", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto-commit after core commands is disabled by default and enabled per event key in git-config.yml with fallback to auto_commit.default \u2014 commits only happen where the maintainer explicitly opted in."}, {"id": "_specify_extensions_git_readme_snapshot_commit_titles", "label": "Snapshot commit titles (frozen phase with subject and details)", "file_type": "rationale", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_specify_extensions_git_readme_graceful_degradation", "label": "Graceful degradation without Git", "file_type": "rationale", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spec creation must never block on Git: spec directories are still created under specs/, branch creation and validation are skipped with a warning, and remote detection returns empty results instead of erroring."}, {"id": "_specify_extensions_git_readme_feature_branch_scripts", "label": "Cross-platform branch creation scripts (bash / PowerShell)", "file_type": "concept", "source_file": ".specify/extensions/git/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_specify_extensions_git_readme_git_branching_workflow_extension", "target": "_specify_extensions_git_commands_speckit_git_commit_auto_commit_command", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specify/extensions/git/README.md", "source_location": null, "weight": 1.0}, {"source": "_specify_extensions_git_readme_git_branching_workflow_extension", "target": "_specify_extensions_git_commands_speckit_git_feature_create_feature_branch_command",