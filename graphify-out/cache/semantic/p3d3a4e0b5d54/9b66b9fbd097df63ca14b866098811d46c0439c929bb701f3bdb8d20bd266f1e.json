{"nodes": [{"id": "specs_001_archetype_integration_tests_research_manual_fixture_curation", "label": "Manual fixture curation (dependency rule per fixture)", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual curation keeps fixtures readable; the archetype itself rejects semantically invalid combinations (unknown properties cause generation failure), providing a natural safety net; programmatic matrix generation from DEPENDS_ON comments is possible future work but was out of scope."}, {"id": "specs_001_archetype_integration_tests_research_verify_groovy_apache_convention", "label": "verify.groovy Apache binding convention (basedir/scriptdir/context)", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aligns with the ecosystem standard documented in apache/maven-archetype#1032 \u2014 receive basedir, scriptdir and context as binding variables and return null or true to pass; no reinvention, no separate runner."}, {"id": "specs_001_archetype_integration_tests_research_apache_maven_archetype_1032", "label": "apache/maven-archetype#1032 (Apache's own archetype IT precedent, 33 passing ITs)", "file_type": "concept", "source_file": "specs/001-archetype-integration-tests/research.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_001_archetype_integration_tests_research_verify_groovy_apache_convention", "target": "specs_001_archetype_integration_tests_research_apache_maven_archetype_1032", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/research.md", "source_location": null, "weight": 1.0}