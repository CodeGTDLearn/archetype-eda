{"nodes": [{"id": "specs_002_native_groovy_composer_spec_composer_rename", "label": "Rename: SnippetComposer to ArchetypePostGenerateComposer", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renamed 2026-11-04; the composer file lives at src/main/groovy/ArchetypePostGenerateComposer.groovy."}, {"id": "specs_002_native_groovy_composer_spec_groovy_snippet_injection_decision", "label": "groovy-snippet-injection assessment (verdict: go, Option B)", "file_type": "concept", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Origin decision documented in .specify/assessments/groovy-snippet-injection/decision.md; native Groovy build-time composition (Option B of the concept) was chosen over a custom JUnit harness (rejected as reinventing the wheel) and external archetype-testing tools (none exists in this ecosystem)."}, {"id": "specs_002_native_groovy_composer_spec_fr004_byte_equivalence", "label": "FR-002-family FR-004: byte-equivalence with the historical bash output", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Byte-equivalence (verifiable by empty diff and identical SHA-256) was the acceptance criterion of the migration; the bash script no longer exists, so the current regression gate is ComposerTest plus the parse of the generated artifact."}, {"id": "specs_002_native_groovy_composer_spec_fr006_sections_literal", "label": "FR-006: SECTIONS as a single readable literal data structure", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The order configuration MUST live in one List<String> at the top of the composer with a short comment per item \u2014 a single auditable source of truth for assembly order instead of order scattered across the code."}, {"id": "specs_002_native_groovy_composer_spec_fr007_snippet_marker", "label": "FR-007: SNIPPET-NN marker convention (flag coupling)", "file_type": "rationale", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each snippet must declare its own filename in uppercase as a marker (validated by the composer, which fails the build if missing); the coupling to the activation flag is made by the same-named variable evaluated in the snippet body, keeping flag and behavior in one auditable place."}, {"id": "specs_002_native_groovy_composer_spec_sc001_15_it_profiles", "label": "SC-001: 15 IT profiles (grown from 9)", "file_type": "concept", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_002_native_groovy_composer_spec_composertest", "label": "ComposerTest (composer regression gate: structure, order, idempotency, parse)", "file_type": "code", "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_002_native_groovy_composer_spec_composer_rename", "target": "specs_002_native_groovy_composer_plan_archetypepostgeneratecomposer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/002-native-groovy-composer/spec.md", "source_location": null, "weight": 1.0}, {"source": "specs_002_native_groovy_composer_spec_groovy_snippet_injection_decision", "target": "specs_002_native_groovy_composer_plan_