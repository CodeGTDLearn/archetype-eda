us", "label": "Operational Corpus (index, procedure, README, fixtures, suites)", "file_type": "concept", "source_file": "specs/011-rename-contract-rule-files/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_contract_rule_files_spec_legacy_redirect_requirement", "label": "Legacy Redirect Requirement (FR-011)", "file_type": "concept", "source_file": "specs/011-rename-contract-rule-files/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_contract_rule_files_spec_normative_content_preservation", "label": "Normative Content Preservation (FR-004, FR-014)", "file_type": "concept", "source_file": "specs/011-rename-contract-rule-files/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rename must not become a silent rule change: rules, definitions, domain examples, JSON keys, defaults and contract format are frozen, and only reference tokens may differ."}, {"id": "specs_011_rename_contract_rule_files_spec_invariants_19_13_6_4", "label": "Procedure Invariants 19/13/6/4 (FR-005, FR-006, SC-004)", "file_type": "concept", "source_file": "specs/011-rename-contract-rule-files/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_011_rename_contract_rule_files_spec_three_phase_user_stories", "label": "Three-Phase User Stories (US1 P1, US2 P2, US3 P3)", "file_type": "concept", "source_file": "specs/011-rename-contract-rule-files/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_011_rename_contract_rule_files_spec_feature_specification", "target": "specs_011_rename_contract_rule_files_spec_folder_rename_requirement", "relation": "references", "confidence": "EXTRACTED",