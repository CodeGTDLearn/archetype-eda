{"nodes": [{"id": "specs_001_archetype_integration_tests_plan_integration_test_matrix", "label": "Integration Test Matrix for eda-archetype", "file_type": "concept", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Curated, not exhaustive: the maintainer prioritizes coverage and simplicity over speed; built on the standard maven-archetype-plugin integration-test goal \u2014 the same mechanism Apache uses for its own archetype \u2014 rather than a custom JUnit harness (rejected as reinventing the wheel, high cost, low value)."}, {"id": "specs_001_archetype_integration_tests_plan_maven_archetype_plugin_integration_test", "label": "maven-archetype-plugin integration-test goal", "file_type": "concept", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_001_archetype_integration_tests_plan_constitution_principle_i", "label": "Constitution Principle I: Modularidade por Chave de Ativacao", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NON-NEGOTIABLE: every capability is an activation flag; the matrix is the explicit expression of this principle in test form \u2014 each fixture asserts that a flag does what it claims, and the DEPENDS_ON rule enforces that a disabled parent disables its children."}, {"id": "specs_001_archetype_integration_tests_plan_constitution_principle_ii", "label": "Constitution Principle II: Convencao Fixa de Nomenclatura", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NON-NEGOTIABLE: fixed naming conventions \u2014 fixture subdirectories follow the existing src/test/resources/projects/<name>/archetype.properties convention, keeping the matrix self-documenting in the filesystem."}, {"id": "specs_001_archetype_integration_tests_plan_constitution_principle_iv", "label": "Constitution Principle IV: Binding Duplo de Configuracao Externalizada", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The binding-properties scenario explicitly provides one fixture per sub-module (default, list, map, mutable, validated) so the immutable and mutable variants are exercised independently \u2014 the auditable surface for this principle."}, {"id": "specs_001_archetype_integration_tests_plan_constitution_principle_vi", "label": "Constitution Principle VI: Validar Antes de Culpar o Codigo", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The feature is explicitly designed to run after a clean local install of the archetype; the suite assumes the cache is fresh \u2014 a dirty cache is a known environmental issue, not a feature failure mode."}], "edges": [{"source": "specs_001_archetype_integration_tests_plan_integration_test_matrix", "target": "specs_001_archetype_integration_tests_spec_user_story_1_minimal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/plan.md", "source_location": null, "weight": 1.0}, {"source": "specs_001_archetype_integration_tests_plan_integration_test_matrix", "target": "specs_001_archetype_integration_tests_spec_user_story_2_full", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetyp