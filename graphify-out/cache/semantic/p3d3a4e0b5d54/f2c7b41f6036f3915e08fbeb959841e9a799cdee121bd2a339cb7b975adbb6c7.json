{"nodes": [{"id": "_specify_assessments_llm_flag_inference_concept_llm_flag_inference", "label": "Concept: LLM inference of mvn archetype:generate flags", "file_type": "document", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L1-L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_specify_assessments_llm_flag_inference_concept_option_b_llm_mapping_validator", "label": "Option B (recommended): LLM proposes mapping, deterministic validator applies catalog defaults", "file_type": "rationale", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L22-L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only option covering all 6 goals at once: the validator gives fail-fast against LLM flag hallucination, reproducibility via temperature 0 plus a deterministic cache, defaults applied by code rather than the LLM, and the JSON contract gets a formal place with explicit fail-fast."}, {"id": "_specify_assessments_llm_flag_inference_concept_option_a_single_prompt", "label": "Option A: single prompt emits the full mvn archetype:generate line", "file_type": "rationale", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L9-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejected: a hallucinated flag or type fails mvn archetype:generate at runtime with a confusing message, and output is not reproducible between runs - costs that get expensive later."}, {"id": "_specify_assessments_llm_flag_inference_concept_option_c_keep_bash", "label": "Option C: keep bash_script/ (do-nothing baseline)", "file_type": "rationale", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L37-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baseline confirming B is worth the investment: none of the 6 goals is met, the JSON contract stays implicit, and the 10-step per-flag ritual documented in README.md keeps growing the bash_script/ directory."}, {"id": "_specify_assessments_llm_flag_inference_concept_deterministic_flag_validator", "label": "Deterministic flag validator against archetype-metadata.xml", "file_type": "concept", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L24, L59", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The validator extracts requiredProperty key/default/validationRegex dynamically from archetype-metadata.xml (via the 17 XInclude XMLs) so it never drifts from the catalog when a new flag enters."}, {"id": "_specify_assessments_llm_flag_inference_concept_json_contract_precedence", "label": "JSON contract precedence rule (contract beats LLM; out-of-contract proposals discarded)", "file_type": "rationale", "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decided at intake: the JSON contract takes precedence over LLM inference, and flags proposed by the LLM that are absent from the contract are discarded (silenced) with the archetype default applied."}], "edges": [{"source": "_specify_assessments_llm_flag_inference_concept_llm_flag_inference", "target": "_specify_assessments_llm_flag_inference_concept_option_b_llm_mapping_validator", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specify/assessments/llm-flag-inference/concept.md", "source_location": "L5, L48", "weight": 1.0}, {"source": "_specify_assessments_llm_flag_inference_concept_llm_flag_inference", "target": "_specify_assessments_llm_flag_inference_concept_option_a_single_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".specify/assess