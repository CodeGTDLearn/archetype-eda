{"nodes": [{"id": "_opencode_commands_speckit_git_commit_auto_commit_changes", "label": "Auto-Commit Changes command (speckit.git.commit)", "file_type": "document", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L8-L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_opencode_commands_speckit_git_commit_commit_style", "label": "Commit message styles (fixed / conventional / snapshot)", "file_type": "rationale", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L23-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "commit_style lets before_* hooks freeze the previous phase as a rollback snapshot while fixed mode keeps static per-command messages; conventional mode must pass the generated message via a temp file, never interpolated into a shell string, because the message is derived from repository changes and may contain quotes or command substitutions."}, {"id": "_opencode_commands_speckit_git_commit_conventional_commit_style", "label": "Conventional commit message generation", "file_type": "rationale", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_opencode_commands_speckit_git_commit_snapshot_commit_style", "label": "Snapshot rollback commit (before_* hooks)", "file_type": "rationale", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshot freezes the state left by the previous phase so it can be rolled back; the frozen phase is classified from the staged diff (src/ to Implement, tasks.md to Tasks, checklists/ to Checklist, plan artifacts to Plan, spec.md to Specify; first match wins) rather than from hook order, because /analyze and /checklist may run in either order. The last phase of a branch gets no snapshot on purpose - it closes with a PR/merge."}, {"id": "_opencode_commands_speckit_git_commit_git_config_yml", "label": ".specify/extensions/git/git-config.yml (git extension config)", "file_type": "concept", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L57-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_opencode_commands_speckit_git_commit_graceful_degradation", "label": "Graceful degradation pattern (Spec Kit git extension)", "file_type": "rationale", "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": "L75-L82", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git must never block the Spec Kit workflow: missing Git, a non-repo directory, a missing config file, nothing to commit, or a missing generated message each degrade to a warning/skip instead of an error; snapshot mode never blocks the phase."}], "edges": [{"source": "_opencode_commands_speckit_git_commit_auto_commit_changes", "target": "_opencode_commands_speckit_git_commit_git_config_yml", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_commands_speckit_git_commit_auto_commit_changes", "target": "_opencode_commands_speckit_git_commit_graceful_degradation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_commands_speckit_git_commit_commit_style", "target": "_opencode_commands_speckit_git_commit_conventional_commit_style", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_commands_speckit_git_commit_commit_style", "target": "_opencode_commands_speckit_git_commit_snapshot_commit_style", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": null, "weight": 1.0}, {"source": "_opencode_commands_speckit_git_commit_auto_commit_changes", "target": "_opencode_commands_speckit_git_commit_commit_style", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "speckit_git_extension_commands", "label": "Spec Kit git extension command set (auto-commit, feature branch, init, remote, validate)", "nodes": ["_opencode_commands_speckit_git_commit_auto_commit_changes", "_opencode_commands_speckit_git_feature_create_feature_branch", "_opencode_commands_speckit_git_initialize_initialize_git_repository", "_opencode_commands_speckit_git_remote_detect_git_remote_url", "_opencode_commands_speckit_git_validate_validate_feature_branch", "_opencode_commands_speckit_git_commit_git_config_yml"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".opencode/commands/speckit.git.commit.md"}]}