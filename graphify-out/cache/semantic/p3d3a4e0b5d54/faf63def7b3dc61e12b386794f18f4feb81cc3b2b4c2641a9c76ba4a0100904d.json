{"nodes": [{"id": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "label": "Quickstart: end-to-end matrix validation guide", "file_type": "document", "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focuses on the end-to-end validation flow; implementation details live in the spec and plan \u2014 the living matrix (flags under test and what each verify.groovy asserts) lives in src/test/resources/projects/README.md and is kept honest by FixturesMatrixTest.groovy rather than duplicated here."}, {"id": "specs_001_archetype_integration_tests_quickstart_regression_bait", "label": "Regression-bait manual check", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept manual because automation would require mutating production source (archetype-post-generate.groovy) and a failed restore would leave the archetype broken; the full matrix provides equivalent implicit coverage \u2014 any regression in the post-processor breaks every fixture."}, {"id": "specs_001_archetype_integration_tests_quickstart_single_fixture_isolation", "label": "Single-fixture local loop (archetype.test.projectsDirectory)", "file_type": "rationale", "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "maven-archetype-plugin:3.4.1 has no per-name filter \u2014 archetype.test.projects does not exist; pointing projectsDirectory at a directory holding only that fixture is the only way to isolate a single scenario."}, {"id": "specs_001_archetype_integration_tests_quickstart_fixturesmatrixtest", "label": "FixturesMatrixTest.groovy (living-matrix verifier)", "file_type": "code", "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "target": "specs_001_archetype_integration_tests_plan_integration_test_matrix", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "weight": 1.0}, {"source": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "target": "specs_001_archetype_integration_tests_spec_fr007_offline_constraint", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "weight": 1.0}, {"source": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "target": "specs_001_archetype_integration_tests_spec_fr004_dependency_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "weight": 1.0}, {"source": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "target": "specs_001_archetype_integration_tests_spec_fr012_security_observability_exclusion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "weight": 1.0}, {"source": "specs_001_archetype_integration_tests_quickstart_matrix_validation_guide", "target": "specs_001_archetype_integration_tests_quickstart_fixturesmatrixtest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "specs/001-archetype-integration-tests/quickstart.md", "source_location": null, "weight": 1.